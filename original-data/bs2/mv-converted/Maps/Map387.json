s":["\"Good morning."]},{"code":401,"indent":0,"parameters":[" Please forgive me for waking you.\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"You looked lovely during your short nap."]},{"code":401,"indent":0,"parameters":[" It must've been a pleasant dream, fufu.\""]},{"code":246,"indent":0,"parameters":[10]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"...As ever, the Crawling One"]},{"code":401,"indent":0,"parameters":[" continues its never-ending assault"]},{"code":401,"indent":0,"parameters":[" on Wonderland in a mad fury.\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"But now that you've awakened as a Creator,"]},{"code":401,"indent":0,"parameters":[" Lord \\n[1], it will be trivial for you to deal"]},{"code":401,"indent":0,"parameters":[" with it, I'm sure.\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"All the preparations are done. The Garden is ready."]},{"code":401,"indent":0,"parameters":[" Our children are many in number, in full force"]},{"code":401,"indent":0,"parameters":[" they will cover the land and blot out the sky.\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Once you've dealt with the Crawling One,"]},{"code":401,"indent":0,"parameters":[" together we will all head for the end of the world."]},{"code":401,"indent":0,"parameters":[" Neither the Idiot, nor the nothingness, you don't"]},{"code":401,"indent":0,"parameters":[" have to fear anything anymore.\""]},{"code":230,"indent":0,"parameters":[30]},{"code":245,"indent":0,"parameters":[{"name":"やや濡れぐちょぐちょ（５秒）","pan":0,"pitch":55,"volume":100}]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Mmm...♡"]},{"code":401,"indent":0,"parameters":[" Ah, I'm terribly sorry."]},{"code":401,"indent":0,"parameters":[" My long talk must've bored you.\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Aah, mmm..."]},{"code":401,"indent":0,"parameters":[" While you slept, I had to remain separate from you"]},{"code":401,"indent":0,"parameters":[" for so long. All this time my body has been aching"]},{"code":401,"indent":0,"parameters":[" for your touch♡\""]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["\\c[10]и@tw╣f@╦w╢K"]},{"code":231,"indent":0,"parameters":[1,"176",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,90,false]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Yes♡\\!"]},{"code":401,"indent":0,"parameters":[" I also love you...♡\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Always, for all eternity, I'll be by your side."]},{"code":401,"indent":0,"parameters":[" And so, aah♡\""]},{"code":101,"indent":0,"parameters":["ノーデ",0,1,2]},{"code":401,"indent":0,"parameters":["\"Please use your Node as a \\c[2]seedbed\\c[0]♡"]},{"code":401,"indent":0,"parameters":[" My dear, beloved Lord \\n[1]...♡\""]},{"code":230,"indent":0,"parameters":[60]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,0,0,60,true]},{"code":353,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}]}],"x":1,"y":0}]
