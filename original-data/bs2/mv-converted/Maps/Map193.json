":0,"parameters":[" and overcoming it all, you've arrived here."]},{"code":401,"indent":0,"parameters":[" That proves the strength of your soul, and,"]},{"code":401,"indent":0,"parameters":[" more than anything...the power of love.\""]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"Love is by no means something that easily"]},{"code":401,"indent":0,"parameters":[" expires. The deeper you thought about me..."]},{"code":401,"indent":0,"parameters":[" the deeper your love grew, until it turned"]},{"code":401,"indent":0,"parameters":[" in a mad pursuit you couldn't deny yourself...\""]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"And yet, you wouldn't continue to feed a caught"]},{"code":401,"indent":0,"parameters":[" fish, and every drunk rush comes to a sobering end. "]},{"code":401,"indent":0,"parameters":[" Once obtained, love loses nearly all of its value.\""]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"Even separated from each other, united in mind"]},{"code":401,"indent":0,"parameters":[" until death do us part...That is what I wanted"]},{"code":401,"indent":0,"parameters":[" to see. The crystallization of such love.\""]},{"code":213,"indent":0,"parameters":[-1,8,true]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"...Here, the animals laugh in joy and flowers"]},{"code":401,"indent":0,"parameters":[" sing lovely songs. It's the land of our dreams."]},{"code":401,"indent":0,"parameters":[" The Wonderland. \\c[2]Paradise\\c[0] I'm presenting"]},{"code":401,"indent":0,"parameters":[" to the one I love the most, to you.\""]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"Here, you can dream as many dreams as you want,"]},{"code":401,"indent":0,"parameters":[" here, you can enjoy as much love as you wish.\\!"]},{"code":401,"indent":0,"parameters":[" There's no need to suffer anymore."]},{"code":401,"indent":0,"parameters":[" My dear, my beloved, my \\n[1]...\""]},{"code":101,"indent":0,"parameters":["アリス・リデル",0,0,2]},{"code":401,"indent":0,"parameters":["\"Please let us dream for all eternity with"]},{"code":401,"indent":0,"parameters":[" your love...\""]},{"code":102,"indent":0,"parameters":[["\\c[2]Make love\\c[0]"],-1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"\\c[2]Make love\\c[0]"]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":213,"indent":0,"parameters":[6,4,true]},{"code":246,"indent":0,"parameters":[2]},{"code":111,"indent":0,"parameters":[0,20,0]},{"code":221,"indent":1,"parameters":[]},{"code":230,"indent":1,"parameters":[20]},{"code":121,"indent":1,"parameters":[801,801,0]},{"code":223,"indent":1,"parameters":[[-255.0,-255.0,-255.0,0.0],1,true]},{"code":222,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":221,"indent":1,"parameters":[]},{"code":243,"indent":1,"parameters":[]},{"code":117,"indent":1,"parameters":[162]},{"code":244,"indent":1,"parameters":[]},{"code":223,"indent":1,"parameters":[[-255.0,-255.0,-255.0,0.0],1,true]},{"code":222,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":250,"indent":0,"parameters":[{"name":"Sword5","pan":0,"pitch":100,"volume":80}]},{"code":224,"indent":0,"parameters":[[255.0,255.0,255.0,255.0],30,true]},{"code":250,"indent":0,"parameters":[{"name":"gucha004a","pan":0,"pitch":100,"volume":80}]},{"code":231,"indent":0,"parameters":[1,"66",0,0,0,0,100,100,255,0]},{"code":224,"indent":0,"parameters":[[0.0,0.0,0.0,255.0],30,true]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["紅ずきん",0,0,2]},{"code":401,"indent":0,"parameters":["\"――I've been waiting for this."]},{"code":401,"indent":0,"parameters":[" \\c[2]The Crawling One\\c[0].\""]},{