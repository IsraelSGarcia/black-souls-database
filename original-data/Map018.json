e":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":null,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true,"list":[{"code":250,"indent":0,"parameters":[{"name":"Move","pan":0,"pitch":100,"volume":80}]},{"code":201,"indent":0,"parameters":[0,73,20,12,0,0]},{"code":0,"indent":0,"parameters":[]}]}],"x":9,"y":19},{"id":4,"name":"EV004","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":null,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true,"list":[{"code":250,"indent":0,"parameters":[{"name":"Move","pan":0,"pitch":100,"volume":80}]},{"code":201,"indent":0,"parameters":[0,73,20,12,0,0]},{"code":0,"indent":0,"parameters":[]}]}],"x":7,"y":19},{"id":5,"name":"EV005","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":null,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true,"list":[{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["-You are old, Father William, and your hair"]},{"code":401,"indent":0,"parameters":["has become very white; And yet you incessantly"]},{"code":401,"indent":0,"parameters":["stand on your head –Do you think, at your age,"]},{"code":401,"indent":0,"parameters":["it is right?"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["In my youth, I feared it might injure the brain;"]},{"code":401,"indent":0,"parameters":["But, now I'm perfectly sure."]},{"code":401,"indent":0,"parameters":["I have none."]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["-You are old, as I mentioned before,"]},{"code":401,"indent":0,"parameters":["And have grown most uncommonly fat;"]},{"code":401,"indent":0,"parameters":["Yet you turned a back-somersault in at the door—"]},{"code":401,"indent":0,"parameters":["Pray, what is the reason of that?"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["In my youth, I kept all my limbs very supple."]},{"code":401,"indent":0,"parameters":["By the use of this ointment—one shilling the box—"]},{"code":401,"indent":0,"parameters":["Allow me to sell you a couple?"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["-You are old, and your jaws are too weak"]},{"code":401,"indent":0,"parameters":["For anything tougher than suet;"]},{"code":401,"indent":0,"parameters":["Yet you finished the goose, with the bones and the beak—"]},{"code":401,"indent":0,"parameters":["Pray, how did you manage to do it?"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["In my youth, I took to the law,"]},{"code":401,"indent":0,"parameters":["And argued each case with my wife;"]},{"code":401,"indent":0,"parameters":["And the muscular strength, which it gave to my jaw,"]},{"code":401,"indent":0,"parameters":["Has lasted the rest of my life."]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["-You are old, one would hardly suppose"]},{"code":401,"indent":0,"parameters":["That your eye was as steady as ever;"]},{"code":401,"indent":0,"parameters":["Yet you balanced an eel on the end of your nose—"]},{"code":401,"indent":0,"parameters":["What made you so awfully clever?"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["I have answered three questions, and that is enough."]},{"code":401,"indent":0,"parameters":["Don't give yourself airs!"]},{"code":401,"indent":0,"parameters":["I'll kill you!"]},{"code":401,"indent":0,"parameters":["Smash you, slice you, break you!"]},{"code":0,"indent":0,"parameters":[]}]}],"x":15,"y":8},{"id":6,"name":"EV006","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":34,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"va