indent":1,"parameters":[7,7,0]},{"code":242,"indent":1,"parameters":[1]},{"code":246,"indent":1,"parameters":[1]},{"code":236,"indent":1,"parameters":["none",9,0,true]},{"code":223,"indent":1,"parameters":[[-255.0,-255.0,-255.0,0.0],60,true]},{"code":245,"indent":1,"parameters":[{"name":"映写機","pan":0,"pitch":150,"volume":100}]},{"code":261,"indent":1,"parameters":["ノイズ "]},{"code":245,"indent":1,"parameters":[{"name":"","pan":0,"pitch":100,"volume":100}]},{"code":355,"indent":1,"parameters":["brain_noise_start"]},{"code":241,"indent":1,"parameters":[{"name":"赤い部屋","pan":0,"pitch":100,"volume":100}]},{"code":355,"indent":1,"parameters":["start_signal"]},{"code":231,"indent":1,"parameters":[1,"black",0,0,0,0,100,100,255,0]},{"code":250,"indent":1,"parameters":[{"name":"剣　突き刺す","pan":0,"pitch":110,"volume":80}]},{"code":224,"indent":1,"parameters":[[255.0,0.0,0.0,255.0],30,true]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]A red room."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]Red carpets, red wallpaper, red desks,"]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["scattered deep red――blood."]},{"code":250,"indent":1,"parameters":[{"name":"剣　突き刺す","pan":0,"pitch":110,"volume":80}]},{"code":224,"indent":1,"parameters":[[255.0,0.0,0.0,153.0],10,true]},{"code":250,"indent":1,"parameters":[{"name":"剣　突き刺す","pan":0,"pitch":110,"volume":80}]},{"code":224,"indent":1,"parameters":[[255.0,0.0,0.0,153.0],10,true]},{"code":250,"indent":1,"parameters":[{"name":"剣　突き刺す","pan":0,"pitch":110,"volume":80}]},{"code":224,"indent":1,"parameters":[[255.0,0.0,0.0,153.0],10,true]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]Dull thuds echo through the room."]},{"code":401,"indent":1,"parameters":["Abdomen, chest, neck, a sharp knife stabs, stabs, stabs."]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["Wounds open and close, and only the pool of blood keeps spreading."]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"Uu, uuu...ghuu, uaaa...\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]The pitter-patter of tears accompanies the thuds of the knife."]},{"code":401,"indent":1,"parameters":["Those aren't tears of pain, but only sorrow."]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["With blood and then tears, this room will soon turn into a pond."]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"I'm sorry..."]},{"code":401,"indent":1,"parameters":[" I'm sorry...\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]The miserable sobbing completes the symphony."]},{"code":401,"indent":1,"parameters":["The knife raises again, this time \\c[10]to sever the neck."]},{"code":250,"indent":1,"parameters":[{"name":"Blow1","pan":0,"pitch":150,"volume":100}]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["A white hand stops the woman's raised arm."]},{"code":101,"indent":1,"parameters":["影",0,0,1]},{"code":401,"indent":1,"parameters":["\"I cannot continue watching this.\\!"]},{"code":401,"indent":1,"parameters":[" Why are you trying to kill yourself?\""]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"....I."]},{"code":401,"indent":1,"parameters":[" Even now, he's suffering,"]},{"code":401,"indent":1,"parameters":[" all because of me.\""]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"And so, because of it, that's why,"]},{"code":401,"indent":1,"parameters":[" I want to share in his pain...\\!"]},{"code":401,"indent":1,"parameters":[" We will never meet again, but in doing so,"]},{"code":401,"indent":1,"parameters":[" I can surely at least grasp his suffering...\""]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["\"This is foolishness."]},{"code":401,"indent":1,"parameters":[" Your harming yourself will not aid him."]},{"code":401,"indent":1,"parameters":[" He would not ever wish for your pain.\""]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["I wanted to say that, wanted to scold her, but I couldn't.\\!"]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["I'm in no place to admonish her. For how long do I"]},{"code":401,"indent":1,"parameters":["plan to luxuriate in a seat where I cannot be blamed...?"]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"I'm absolutely revolting, aren't I?"]},{"code":101,"indent":1,"parameters":["影",0,0,1]},{"code":401,"indent":1,"parameters":["\"...No."]},{"code":401,"indent":1,"parameters":[" I apologize for being unable to follow your wishes.\""]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"Don't say that.\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\\c[10]The red spilling from the wounds \\c[8]turns black."]},{"code":101,"indent":1,"parameters":["影2",0,0,2]},{"code":401,"indent":1,"parameters":["\"I wanted to become just an ordinary human girl...\""]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["Trying to stop any more sadness from spilling from her,"]},{"code":401,"indent":1,"parameters":["I wrap her in a warm embrace."]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["Not as a mimicry of a human, but as someone who"]},{"code":401,"indent":1,"parameters":["loves the same person she does, I understood her"]},{"code":401,"indent":1,"parameters