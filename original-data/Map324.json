y":3,"moveRoute":{"list":[{"code":0,"indent":null,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":true,"through":false,"trigger":0,"walkAnime":false,"list":[{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Day X"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["―――I saw a vision of Hell."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Every room is bloated with patients. It's impossible"]},{"code":401,"indent":0,"parameters":["to shelter even a single person more. I don't even"]},{"code":401,"indent":0,"parameters":["know what's going on outside. Yet every day more"]},{"code":401,"indent":0,"parameters":["and more injured and mentally sick get hospitalized."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["There's not enough staff and infection spreads without slowing"]},{"code":401,"indent":0,"parameters":["down. All the doctors and nurses except for me went mad."]},{"code":401,"indent":0,"parameters":["No, they, who toyed with the corpses of their patients must've"]},{"code":401,"indent":0,"parameters":["been mad to begin with. The only sane person here is me."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Treating and treating, only for a new sickness to be discovered,"]},{"code":401,"indent":0,"parameters":["a cycle without end. And I'm running out of drugs too."]},{"code":401,"indent":0,"parameters":["There's nothing I can do! There really is nothing!"]},{"code":401,"indent":0,"parameters":["Maybe even I will go mad!"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Day XX"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Without sleep, without rest, I must continue treating patients."]},{"code":401,"indent":0,"parameters":["I got used to the all-present stench of rot. Or maybe my sense"]},{"code":401,"indent":0,"parameters":["of smell broke? It's either one or another."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["The one who brought me here seems intent on"]},{"code":401,"indent":0,"parameters":["silently observing without ever lending a hand."]},{"code":401,"indent":0,"parameters":["Outrageous. We are not toys to be played with."]},{"code":401,"indent":0,"parameters":["There's no food, no water. There is no hope."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Will I rot and die in this graveyard of a hospital covered"]},{"code":401,"indent":0,"parameters":["in corpses without saving even a single soul?"]},{"code":401,"indent":0,"parameters":["That, I absolutely cannot accept."]},{"code":401,"indent":0,"parameters":["I will not give up. I will save all of the patients here."]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Day XXX"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Again before my eyes a patient passed away in agony,"]},{"code":401,"indent":0,"parameters":["and all I could do was hold his hand and throw him words of"]},{"code":401,"indent":0,"parameters":["comfort. The weight of my impotence is oppressing."]},{"code":401,"indent":0,"parameters":["And I hate myself for accepting it as \"nothing could be done\"."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["The twins are the only ones I was able to transfer to another"]},{"code":401,"indent":0,"parameters":["medical facility. Even I have already lost my human body."]},{"code":401,"indent":0,"parameters":["Before I lose what makes me me, I have to save as many"]},{"code":401,"indent":0,"parameters":["as I can, even alone......"]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Day XXXX"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Immortalization of a patient succeeded."]},{"code":401,"indent":0,"parameters":["Just as Dr. Jekyll said, the drug made out of those"]},{"code":401,"indent":0,"parameters":["pests is our only way to break the status quo."]},{"code":401,"indent":0,"parameters":["...Still, I cannot ignore the abnormal side effects."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["One of the soldiers under my care refused the immortality"]},{"code":401,"indent":0,"parameters":["treatment. He said, \"I'd rather die a human than turn into"]},{"code":401,"indent":0,"parameters":["an incomprehensible monster\". I paled sharply at his words."]},{"code":401,"indent":0,"parameters":["This treatment really is incompatible with morality."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["And yet, all patients I successfully immortalized lavish me with"]},{"code":401,"indent":0,"parameters":["praise and trust me fully, their loss of humanity notwithstanding."]},{"code":401,"indent":0,"parameters":["For the first time since coming here, I was able to save someone."]},{"code":401,"indent":0,"parameters":["There's no need to worry anymore. I have many people to cure."]},{"code":250,"indent":0,"parameters":[{"name":"Book1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Day XXXXXXXX"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Exiled together with the hospital."]},{"