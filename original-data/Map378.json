":401,"indent":0,"parameters":[" the other day. Even if she's the dean's daughter――"]},{"code":401,"indent":0,"parameters":[" As a teacher, you should also――\""]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["Mr. Robinson, if I may..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\"Hm?"]},{"code":401,"indent":0,"parameters":[" Ah, it's already this hour?"]},{"code":401,"indent":0,"parameters":[" Do forgive me for rambling on.\""]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["I value our talks dearly, they're never a waste of time."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\"Ah, indeed. Weren't you going on an extended leave"]},{"code":401,"indent":0,"parameters":[" starting tomorrow? Ah, to be young and have time for"]},{"code":401,"indent":0,"parameters":[" yourself again!\""]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["For myself? Never. My time belongs to the people closest to me."]},{"code":250,"indent":0,"parameters":[{"name":"Open4","pan":0,"pitch":100,"volume":80}]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\"Those who let their time be drained by others"]},{"code":401,"indent":0,"parameters":[" turn old before they even realize that."]},{"code":401,"indent":0,"parameters":[" Mr. Carroll...\""]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["The nostalgic visions I'm viewing right now,"]},{"code":401,"indent":0,"parameters":["which past are they from?"]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["I try to follow the enigmatic circle of memories."]},{"code":401,"indent":0,"parameters":["Vivid and true, they flow through me.\\!"]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["My door opened."]},{"code":231,"indent":0,"parameters":[2,"ie",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["A scenery I know by heart."]},{"code":401,"indent":0,"parameters":["Three little princesses live on this estate."]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["The gate is opened as if welcoming me in.\\!"]},{"code":401,"indent":0,"parameters":["Without any hesitation, I enter the grounds"]},{"code":401,"indent":0,"parameters":["and follow the marble path."]},{"code":235,"indent":0,"parameters":[2]},{"code":355,"indent":0,"parameters":["end_noise"]},{"code":245,"indent":0,"parameters":[{"name":"","pan":0,"pitch":50,"volume":80}]},{"code":250,"indent":0,"parameters":[{"name":"ドア鍵","pan":0,"pitch":100,"volume":80}]},{"code":230,"indent":0,"parameters":[10]},{"code":250,"indent":0,"parameters":[{"name":"ドアを開ける1","pan":0,"pitch":100,"volume":80}]},{"code":101,"indent":0,"parameters":["",0,1,2]},{"code":401,"indent":0,"parameters":["I turn the key, and the door opens."]},{"code":250,"indent":0,"parameters":[{"name":"ドアを閉める2","pan":0,"pitch":100,"volume":100}]},{"code":230,"indent":0,"parameters":[30]},{"code":231,"indent":0,"parameters":[2,"ie2",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[2,0,0,0,0,0,100,100,255,0,60,true]},{"code":230,"indent":0,"parameters":[60]},{"code":250,"indent":0,"parameters":[{"name":"部屋に駆け込んでくる","pan":0,"pitch":100,"volume":80}]},{"code":250,"indent":0,"parameters":[{"name":"部屋に駆け込んでくる","pan":0,"pitch":90,"volume":80}]},{"code":230,"indent":0,"parameters":[120]},{"code":231,"indent":0,"parameters":[3,"次女立ち絵",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["次女",0,0,2]},{"code":401,"indent":0,"parameters":["\"Ah, teacher's back!\""]