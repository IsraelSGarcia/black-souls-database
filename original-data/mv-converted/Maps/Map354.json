s":[18,18,1]},{"code":121,"indent":1,"parameters":[7,7,0]},{"code":242,"indent":1,"parameters":[1]},{"code":246,"indent":1,"parameters":[1]},{"code":236,"indent":1,"parameters":["none",9,0,true]},{"code":223,"indent":1,"parameters":[[-255.0,-255.0,-255.0,0.0],60,true]},{"code":245,"indent":1,"parameters":[{"name":"映写機","pan":0,"pitch":150,"volume":100}]},{"code":261,"indent":1,"parameters":["ノイズ "]},{"code":245,"indent":1,"parameters":[{"name":"","pan":0,"pitch":100,"volume":100}]},{"code":355,"indent":1,"parameters":["brain_noise_start"]},{"code":245,"indent":1,"parameters":[{"name":"Sea","pan":0,"pitch":50,"volume":75}]},{"code":355,"indent":1,"parameters":["start_signal"]},{"code":231,"indent":1,"parameters":[1,"black",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"As ever, this place stinks of the shore!"]},{"code":401,"indent":1,"parameters":[" My clothes will get moldy!\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"......\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Oh my, wine?"]},{"code":401,"indent":1,"parameters":[" Why thank you. I'll gratefully accept.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"If you know how to win me over with offerings,"]},{"code":401,"indent":1,"parameters":[" you'll have no troubles at all.\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"I heard you stepped down from the stage.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Yes, yes."]},{"code":401,"indent":1,"parameters":[" I was intrigued by that child's masterpiece,"]},{"code":401,"indent":1,"parameters":[" but that's just a ghoul in heat.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"You're asking this viceroy to put on a human"]},{"code":401,"indent":1,"parameters":[" shape and sit in your narrow Garden?"]},{"code":401,"indent":1,"parameters":[" To propagate with that \\c[2]toy\\c[0]?\\!"]},{"code":401,"indent":1,"parameters":[" No, I don't think I will.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Still, I will admit I'm taken with the quality"]},{"code":401,"indent":1,"parameters":[" of its soul. Enough so that I'd like to take it"]},{"code":401,"indent":1,"parameters":[" with me to add to my Shatranj.\\!"]},{"code":401,"indent":1,"parameters":[" Hey, hey, would you mind if I did?\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"......What toy?\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"You take advantage of other's work and act as if"]},{"code":401,"indent":1,"parameters":[" you're the one who made it! You're nothing but a"]},{"code":401,"indent":1,"parameters":[" \\c[2]parasite\\c[0] that keeps sucking on delicious nectar!\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"In the end, your true nature is no different"]},{"code":401,"indent":1,"parameters":[" from Mary Sue's!\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"......\\!fufufufu.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Now, listen here, you."]},{"code":401,"indent":1,"parameters":[" I'm done playing pretend human.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Tell me your own true nature."]},{"code":401,"indent":1,"parameters":[" What can be the reason you went so far as tossing"]},{"code":401,"indent":1,"parameters":[" away the crown to shelter that child, hmmm?\\!"]},{"code":401,"indent":1,"parameters":[" Could it be you wanted to take and devour it?\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"To recline on your throne, to rule, and to exploit."]},{"code":401,"indent":1,"parameters":[" That is a \\c[2]Great One's true nature\\c[0]. Am I wrong?\\!"]},{"code":401,"indent":1,"parameters":[" No matter how hard you polish your appearance,"]},{"code":401,"indent":1,"parameters":[" I can see your black soul!\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"You are wrong."]},{"code":401,"indent":1,"parameters":[" What moves me is 'love' itself.\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Pfff....\\{pffahahahaHAHAHA!\""]},{"code":101,"indent":1,"parameters":["影4",0,0,1]},{"code":401,"indent":1,"parameters":["\"Love? Not you too! Don't make me laugh."]},{"code":401,"indent":1,"parameters":[" This is all a misunderstanding.  It's just the"]},{"code":401,"indent":1,"parameters":[" instinct to preserve their species all animals"]},{"code":401,"indent":1,"parameters":[" have.\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"No. I understand love."]},{"code":401,"indent":1,"parameters":[" I understand emotions.\\!"]},{"code":401,"indent":1,"parameters":[" I understand......\\!the human heart!\""]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"It is a language that transcends species."]},{"code":401,"indent":1,"parameters":[" The glorious \\c[2]human heart\\c[0] that can give birth to"]},{"code":401,"indent":1,"parameters":[" each and every emotion!\\! That's the one miracle"]},{"code":401,"indent":1,"parameters":[" any Outer One wishes to obtain!\" "]},{"code":101,"indent":1,"parameters":["影",0,0,2]},{"code":401,"indent":1,"parameters":["\"Even if it's only faux-humanity, that's fine."]},{"code":401,"indent":1,"parameters":[" I want to understand him."]},{"code":401,"indent":1,"parameters":[" I want to know true love."]},{"code":