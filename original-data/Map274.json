e,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"","direction":2,"pattern":0,"characterIndex":0},"moveFrequency":3,"moveRoute":{"list":[{"code":0,"indent":null,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true,"list":[{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":4,"indent":null,"parameters":[]},{"code":4,"indent":null,"parameters":[]},{"code":4,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]},{"code":3,"indent":null,"parameters":[]},{"code":19,"indent":null,"parameters":[]},{"code":0,"indent":null,"parameters":[]}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":4,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":3,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":3,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":3,"indent":null,"parameters":[]}]},{"code":505,"indent":0,"parameters":[{"code":19,"indent":null,"parameters":[]}]},{"code":223,"indent":0,"parameters":[[-255.0,-255.0,-255.0,0.0],60,true]},{"code":250,"indent":0,"parameters":[{"name":"開演ブザー","pan":0,"pitch":100,"volume":70}]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["—The screening begins   SOON"]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["Be quiet during the screening—"]},{"code":121,"indent":0,"parameters":[18,18,1]},{"code":231,"indent":0,"parameters":[1,"109",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["プリ",0,0,2]},{"code":401,"indent":0,"parameters":["\"It must be lots of fun, right, \\n[1]?\""]},{"code":121,"indent":0,"parameters":[7,7,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,0,0,60,true]},{"code":251,"indent":0,"parameters":[]},{"code":245,"indent":0,"parameters":[{"name":"映写機","pan":0,"pitch":100,"volume":80}]},{"code":261,"indent":0,"parameters":["ya6vq-bvs2s"]},{"code":355,"indent":0,"parameters":["start_noise"]},{"code":231,"indent":0,"parameters":[1,"black",0,0,0,0,100,100,255,0]},{"code":223,"indent":0,"parameters":[[34.0,-34.0,-68.0,170.0],1,true]},{"code":111,"indent":0,"parameters":[0,646,0]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["[Isolation Room's Neighbor]"]},{"code":241,"indent":1,"parameters":[{"name":"精神病棟","pan":0,"pitch":50,"volume":100}]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["I'm imprisoned."]},{"code":401,"indent":1,"parameters":["Locked in a narrow, oppressive birdcage which forces"]},{"code":401,"indent":1,"parameters":["me to remember the white prison of my past."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["...My memory is in a terrible state."]},{"code":401,"indent":1,"parameters":["Why am I here? How long have I been here?"]},{"code":401,"indent":1,"parameters":["It took a lot of time to grasp any of it clearly."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["...Of course, I'm in a mental ward.\\! Naturally, there's"]},{"code":401,"indent":1,"parameters":["nothing wrong with my head.\\! It's the nurses that tossed"]},{"code":401,"indent":1,"parameters":["me in here who are insane. Annoying whores...I'll tear"]},{"code":401,"indent":1,"parameters":["their flesh to pieces and throw it into the trash."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Unfamiliar anger burns within my soul."]},{"code":401,"indent":1,"parameters":["The whores are filth. Spreading syphilis, they rule this"]},{"code":401,"indent":1,"parameters":["town like a horde of rats. And the foolish men that fall"]},{"code":401,"indent":1,"parameters":["for them deserve no salvation either."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Before long the bubbling hatred overtakes me, I let out"]},{"code":401,"indent":1,"parameters":["a howl of rage and smash my hands into the floor again"]},{"code":401,"indent":1,"parameters":["and again. Until my fists bleed, until my teeth creak,"]},{"code":401,"indent":1,"parameters":["I scream, \"Hurry and let me out of here!\"."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["And as always when that happens, my neighbor soothes me."]},{"code":231,"indent":1,"parameters":[2,"114",0,0,0,0,100,100,0,0]},{"code":232,"indent":1,"parameters":[2,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Her name is Edith Liddell..."]},{"code":401,"indent":1,"parameters":["A disgustingly cowardly girl with no individuality."]},{"code":401,"indent":1,"parameters":["It took me many months even to get the name out of her."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Edith is no whore, of that I'm sure. My nose can tell me"]},{"code":401,"indent":1,"parameters":["that much. She's been here from before and never seen the"]},{"code":401,"indent":1,"parameters":["outside world. Before I even realized, a sense of sympathy"]},{"code":401,"indent":1,"parameters":["for her pitiful situation took hold within me."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"D-don't be angry...calm down...\""]},{"code":401,"indent":1,"parameters":["A frail voice comes from the other side of the wall."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["Her mind is a delicate thing..."]},{"code":401,"indent":1,"parameters":["So as not to hurt her, I force down my rage and weakly"]},{"code":401,"indent":1,"parameters":["knock on the wall. \"I'm sorry. I'm fine now.\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"G-g-glad to hear...\""]},{"code":401,"indent":1,"parameters":["I can sense relief in Edith's trembling voice.\\!"]},{"code":401,"indent":1,"parameters":["As she does to me, I bring calm to the soul within her."]},{"code":401,"indent":1,"parameters":["Remaining in this room alone really was driving me insane."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["I keep talking with her, stopping only to sleep. About the"]},{"code":401,"indent":1,"parameters":["outside world. About her sisters. About her favorite ring.\\!"]},{"code":401,"indent":1,"parameters":["The more I know her, the more I wish to protect her. Edith"]},{"code":401,"indent":1,"parameters":["really is brittle, the disastrous outside would break her."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["It's not that I hate all women.\\! But the swarms of whores"]},{"code":401,"indent":1,"parameters":["spreading sickness outside well deserve my hatred."]},{"code":401,"indent":1,"parameters":["Unless I slaughter them to the last, I cannot let"]},{"code":401,"indent":1,"parameters":["Edith see the outside world she so dreams of."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Someday, one day I'll take you outside.\\!"]},{"code":401,"indent":1,"parameters":[" But it will take time, maybe even a lot of it."]},{"code":401,"indent":1,"parameters":[" Will you trust in me and wait until then?\"\\!"]},{"code":401,"indent":1,"parameters":["Knocking on the wall, I wait for her reply."]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Y-yes...I'll wait...always, no matter how long it will"]},{"code":401,"indent":1,"parameters":[" take...\"\\!, the sobbing promise of my isolation room's"]},{"code":401,"indent":1,"parameters":["neighbor reaches me."]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":[""]},{"code":401,"indent":1,"parameters":["　　　　　　　　　　　　　     THE　END"]},{"code":246,"indent":1,"parameters":[2]},{"code":242,"indent":1,"parameters":[2]},{"code":355,"indent":1,"parameters":["end_noise"]},{"code":232,"indent":1,"parameters":[2,0,0,0,0,0,100,100,0,0,60,true]},{"code":231,"indent":1,"parameters":[3,"109",0,0,0,0,100,100,0,0]},{"code":232,"indent":1,"parameters":[3,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":1,"parameters":["プリ",0,0,2]},{"code":401,"indent":1,"parameters":["\"They hadn't seen each other even once, and yet"]},{"code":401,"indent":1,"parameters":[" their minds were able to meet, so romantic!☆"]},{"code":401,"indent":1,"parameters":[" I hope afterwards the two of them united"]},{"code":401,"indent":1,"parameters":[" as lovers～!\""]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":111,"indent":0,"parameters":[0,647,0]},{"code":101,"indent":1,"parameters":["",0,1,1]},{"code":401,"indent":1,"parameters":["[Violence Demon Victoria]"]},{"code":241,"indent":1,"parameters":[{"name":"ビク","pan":0,"pitch":100,"volume":100}]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria, why do you don servant's attire?\""]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["\"Dear sister, these clothes are to tempt men better.\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria, then why have you not stole any vigor?\""]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["\"Dear sister, my character has always been passive."]},{"code":401,"indent":1,"parameters":[" I cannot make the first step towards a man.\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria...\\!Then why on earth are you \\c[2]wet with blood\\c[0]?\""]},{"code":231,"indent":1,"parameters":[2,"113",0,0,0,0,100,100,0,0]},{"code":232,"indent":1,"parameters":[2,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["\"Dear sister, this...ah, even though my mind understands"]},{"code":401,"indent":1,"parameters":[" the need, I cannot suppress it no matter how hard I try.\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria...this path is not of a succubus, but of"]},{"code":401,"indent":1,"parameters":[" a simple senseless demon.\""]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["\"But dear sister..."]},{"code":401,"indent":1,"parameters":[" Aren't the sacks of blood and semen much the same?\""]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria...you have no right to call yourself a succubus."]},{"code":401,"indent":1,"parameters":[" The violence has spread throughout your mind.\\!"]},{"code":401,"indent":1,"parameters":[" You are a 'demon of violence', a disgusting abomination.\""]},{"code":101,"indent":1,"parameters":["",0,1,0]},{"code":401,"indent":1,"parameters":["\"Dear sister...\\!"]},{"code":401,"indent":1,"parameters":[" You're quite right. With lust alone it's uncontainable.\\!"]},{"code":401,"indent":1,"parameters":[" The more intimate I get with the target of my desire"]},{"code":401,"indent":1,"parameters":[" for flesh, the more violent my excitement grows.\""]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["",0,1,2]},{"code":401,"indent":1,"parameters":["\"Victoria......what are you doing?!\\!"]},{"code":401,"in